# AWS Oval Insights API (server-only). Leave INSIGHTS_API_URL empty to use the temporary
# placeholder until the API is built.
INSIGHTS_API_URL=
INSIGHTS_API_KEY=

# Oval Hub v2 upstreams. The Next server calls these. The browser does not.
# API Gateway base from the v2 app (no trailing slash). RugbyViz goes to {base}/oval-proxy/.
OVAL_API_GATEWAY_URL=
# Optional. Defaults to {OVAL_API_GATEWAY_URL}/oval-proxy
OVAL_PROXY_URL=
# Direct RugbyViz base used by v2 event search. Example: https://api.rugbyviz.com/rugby/v1
RUGBYVIZ_API_URL=
RUGBYVIZ_BASIC_USER=
RUGBYVIZ_BASIC_PASSWORD=
# Cognito id token, used when a request has no Authorization header.
OVAL_UPSTREAM_AUTHORIZATION=
# Xeatre video. User, password and key are required before /video and player=1 event search will call out.
XEATRE_API_URL=https://ovalinsights.media.xeatre.cloud/api/v1
XEATRE_API_USER=
XEATRE_API_PASSWORD=
XEATRE_API_KEY=
