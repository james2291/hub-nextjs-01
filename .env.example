# AWS Oval Insights API (server-only). Leave INSIGHTS_API_URL empty to use the temporary
# placeholder until the API is built.
INSIGHTS_API_URL=
INSIGHTS_API_KEY=

# Oval Hub v2 upstreams. The Next server calls these. The browser does not.
# API Gateway base from the v2 app (no trailing slash). RugbyViz goes to {base}/oval-proxy/.
OVAL_API_GATEWAY_URL=
# Optional. Defaults to {OVAL_API_GATEWAY_URL}/oval-proxy
OVAL_PROXY_URL=
# Direct RugbyViz base used by v2 event search. Example: https://api.rugbyviz.com/rugby/v1
RUGBYVIZ_API_URL=
RUGBYVIZ_BASIC_USER=
RUGBYVIZ_BASIC_PASSWORD=
# Cognito id token, used when a request has no Authorization header. Every visitor then reads
# upstream as this one user, so it is ignored in production unless ALLOW_SHARED_UPSTREAM_TOKEN=1.
OVAL_UPSTREAM_AUTHORIZATION=
ALLOW_SHARED_UPSTREAM_TOKEN=0
# Xeatre video. User, password and key are required before /video and player=1 event search will call out.
XEATRE_API_URL=https://ovalinsights.media.xeatre.cloud/api/v1
XEATRE_API_USER=
XEATRE_API_PASSWORD=
XEATRE_API_KEY=

# Signs the User Pinned cookie (temporary store for /api/v1/user/pins until sign-in and storage
# exist). Required in production (the server refuses to start without it), at least 32 characters:
#   openssl rand -base64 48
HUB_COOKIE_SECRET=

# Hub clock. Unset = real time. Set to match the design screenshots and the e2e tests:
# HUB_NOW=2026-05-16T14:30:00+01:00
HUB_NOW=

# 1 (default) = bundled 2025/26 demo data, labelled DEMO / ILLUSTRATIVE in the UI.
HUB_DEMO=1

# none (default) | cognito. Cognito sign-in is not built yet: proxy.ts has the hook.
AUTH_MODE=none
